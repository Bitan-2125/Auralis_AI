{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build && python scripts/prepare_static.py",
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.local/**,backend/.env,backend/*.db,backend/.venv/**,backend/tests/**,frontend/node_modules/**}"
    }
  },
  "rewrites": [
    { "source": "/chat/:path*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [ { "key": "Cache-Control", "value": "private, no-store" } ]
    }
  ]
}
