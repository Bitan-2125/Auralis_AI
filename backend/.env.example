# Server-only secrets. Never use VITE_ variables for provider API keys.
GROQ_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=
# Optional routing model override. By default GPT OSS 20B on the active provider decides when to search.
WEB_SEARCH_ROUTER_MODEL=
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./chat.db
FRONTEND_ORIGIN=http://localhost:5173

GROQ_API_BASE=https://api.groq.com/openai/v1
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
CONTEXT_CHAR_BUDGET=24000
MAX_COMPLETION_TOKENS=2048

# Optional third provider; list only model IDs available to your account.
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODELS=

# Vercel: use the Neon pooled PostgreSQL URL instead of SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
UPLOAD_MAX_MB=4
GENERATION_TIMEOUT_SECONDS=260
